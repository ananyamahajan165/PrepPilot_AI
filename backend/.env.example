PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/verbaai
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Access token: short-lived, sent in JSON response body, kept in memory on the client
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

# Refresh token: long-lived, MUST be a different secret than JWT_SECRET,
# delivered only as an httpOnly cookie, never exposed to frontend JS
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret
REFRESH_TOKEN_EXPIRES_IN_SHORT=1d
REFRESH_TOKEN_EXPIRES_IN_LONG=30d

# Used by all AI features (Communication Coach / Interview Practice / Resume Analyzer)
# Gemini API keys — add 2-3 keys here if you have them. The backend
# round-robins across them and automatically fails over to the next key on
# a rate limit, quota, or invalid-key error. A single key still works fine.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Alternative deployment-friendly format:
# GEMINI_API_KEYS=key_1,key_2,key_3

# Google OAuth — from Google Cloud Console (APIs & Services > Credentials).
# GOOGLE_CALLBACK_URL must match EXACTLY (including protocol and path) the
# redirect URI registered in Google Cloud Console for this OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
